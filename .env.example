# Copy this file to .env and fill in real values. .env itself is gitignored.

# Used directly by Prisma/Next.js when running locally (npm run dev / db:migrate / db:seed).
DATABASE_URL="postgresql://postgres:changeme@localhost:8025/mydb?schema=public"

# Used by docker-compose.yml to configure the "db" (PostgreSQL) service, and to build the
# app/migrate containers' internal DATABASE_URL. See the comment above DATABASE_URL in .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mydb
POSTGRES_PORT=8025

# Used by app/api/notify-technicians/route.ts (nodemailer) to email every technician when a
# new repair ticket is created. Any SMTP account works — e.g. Gmail with an App Password,
# your institution's mail server, or an SMTP relay from a transactional email provider.
# Leaving these unset is fine: the route responds with a clear "SMTP not configured" error
# instead of the request looking like it silently failed.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=changeme@example.com
SMTP_PASS=changeme
# Optional — defaults to SMTP_USER when unset.
SMTP_FROM=m-service <changeme@example.com>
# Optional: redirect every notification to one real address you control, instead of the
# real technician account(s) configured in lib/roles.ts — handy while testing.
NOTIFY_OVERRIDE_EMAIL=

# Google sign-in (Auth.js / next-auth v5) — see auth.ts and lib/roles.ts. Only the exact
# emails listed in lib/roles.ts can sign in; everyone else is rejected at the signIn callback.
#
# 1. https://console.cloud.google.com/apis/credentials → Create Credentials → OAuth client ID
#    → Application type "Web application"
# 2. Add every environment's URL to the SAME OAuth client (one client can serve local +
#    production — no need for a second client unless you want separate credentials per env):
#      Authorized JavaScript origins:
#        http://localhost:3000
#        https://your-production-domain.example
#      Authorized redirect URIs:
#        http://localhost:3000/api/auth/callback/google
#        https://your-production-domain.example/api/auth/callback/google
# 3. Copy the Client ID / Client secret it gives you into the two values below.
AUTH_GOOGLE_ID=changeme.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=changeme
# Random value used to encrypt session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT value per environment (local vs. production).
AUTH_SECRET=changeme
# Canonical URL of THIS deployment — required in production (self-hosted behind a reverse
# proxy, e.g. the Docker setup here) so Auth.js builds correct callback/redirect URLs instead
# of guessing from request headers. Leave unset for local dev (defaults to localhost:3000).
# AUTH_URL=https://your-production-domain.example
